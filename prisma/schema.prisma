// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Manter as enums existentes
enum Role {
  MEMBER
  ADMIN
  GESTOR // Adicionado para identificar o criador da conta
}

enum PostoType {
  COMBUSTIVEL
  GAS
  MISTO
}

model User {
  id         Int     @id @default(autoincrement())
  nome       String // Capturado no Step 3
  email      String  @unique // Capturado no Step 3
  password   String // Necessário para o login
  Age        Int?  
  phone      String?
  role       Role    @default(MEMBER)
  image_path String?
  isAlive    Boolean @default(false)

  // Relacionamento: Um gestor pode gerir um ou mais postos
  postos        Posto[]
  notifications notifications[]

  // Relacionamento: Postos salvos (favoritos)
  savedPosts   SavedPosto[]

  // Relacionamento: Comunidades
  membros           ComunidadeMembro[]
  comunidadesCriadas Comunidade[] @relation("ComunidadeCriador")
  convitesEnviados  Convite[]  @relation("ConvitesEnviados")
  convitesRecebidos Convite[]  @relation("ConvitesRecebidos")

  created_at DateTime @default(now())

  @@map("users")
}

model Posto {
  id                  Int       @id @default(autoincrement())
  nome                String // "Nome da Empresa" no Step 1
  email_institucional String? // Capturado no Step 1
  nif                 String    @unique // Capturado no Step 1
  tipo                PostoType @default(MISTO)

  // Localização
  latitude  Float? // Pode ser nulo até o GPS ativar
  longitude Float?
  endereco  String? // "Localização" no Step 1 (String ou ID de província)

  // Novos campos do Step 2
  horario_funcionamento String?
  alvara_path           String? // Caminho do arquivo do "Upload do Alvará"

  // Relacionamentos
  gestor   User     @relation(fields: [gestorId], references: [id])
  gestorId Int

  stocks Stock[]

  // Relacionamento: Postos salvos (favoritos)
  savedByUsers SavedPosto[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("postos")
}

model Produto {
  id             Int     @id @default(autoincrement())
  nome           String // Ex: Gasolina, Gasóleo
  unidade_medida String // L ou UN
  stocks         Stock[]

  @@map("produtos")
}

model Stock {
  id                Int     @id @default(autoincrement())
  quantidade_atual  Float   @default(0)
  capacidade_maxima Float   @default(0)
  preco_unitario    Float // "Preço Atual" no Step 2

  posto     Posto   @relation(fields: [postoId], references: [id])
  postoId   Int
  produto   Produto @relation(fields: [produtoId], references: [id])
  produtoId Int

  updated_at DateTime @updatedAt

  @@map("stocks")
}

// Manter notificações como está
model notifications {
  id         Int      @id @default(autoincrement())
  content    String
  created_at DateTime @default(now())
  users      User     @relation(fields: [userId], references: [id])
  userId     Int
}

model Comunidade {
  id          Int      @id @default(autoincrement())
  nome        String
  descricao   String?
  created_by  Int
  created_at  DateTime @default(now())

  criador User   @relation("ComunidadeCriador", fields: [created_by], references: [id])
  membros ComunidadeMembro[]
  convites Convite[]

  @@map("comunidades")
}

model ComunidadeMembro {
  id            Int      @id @default(autoincrement())
  user_id       Int
  comunidade_id Int
  joined_at     DateTime @default(now())

  user       User       @relation(fields: [user_id], references: [id])
  comunidade Comunidade @relation(fields: [comunidade_id], references: [id])

  @@unique([user_id, comunidade_id])
  @@map("comunidade_membros")
}

model Convite {
  id            Int      @id @default(autoincrement())
  de_user_id    Int
  para_user_id  Int
  comunidade_id Int
  status        String   @default("PENDENTE")
  created_at    DateTime @default(now())

  de_user    User       @relation("ConvitesEnviados", fields: [de_user_id], references: [id])
  para_user  User       @relation("ConvitesRecebidos", fields: [para_user_id], references: [id])
  comunidade Comunidade @relation(fields: [comunidade_id], references: [id])

  @@map("convites")
}

// Modelo para Postos Salvos (Favoritos)
model SavedPosto {
  id        Int     @id @default(autoincrement())
  user      User    @relation(fields: [userId], references: [id])
  userId    Int
  posto     Posto   @relation(fields: [postoId], references: [id])
  postoId   Int
  created_at DateTime @default(now())

  @@unique([userId, postoId]) // Um usuário não pode salvar o mesmo posto duas vezes
  @@map("saved_postos")
}
